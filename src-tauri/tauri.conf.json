{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LuJie CareerKit Preview",
  "version": "0.4.0",
  "identifier": "dev.chozzc.lujie.preview",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeDevCommand": "npm run desktop:prepare",
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [{
        "identifier": "save-before-close",
        "windows": ["main"],
        "local": false,
        "remote": { "urls": ["http://127.0.0.1:43187/*"] },
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-destroy"]
      }],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": { "backend/": "backend/" },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
